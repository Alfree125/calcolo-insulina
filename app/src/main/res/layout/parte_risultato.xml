<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_risultato"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorPrimaryContainer"
    app:cardCornerRadius="28dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dose_totale"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <TextView
            android:id="@+id/out_totale"
            android:layout_width="match_parent"
            android:layout_height="@dimen/altezza_totale"
            android:gravity="bottom|start"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/placeholder"
            android:textAppearance="?attr/textAppearanceDisplayLarge"
            android:textColor="?attr/colorOnPrimaryContainer"
            app:autoSizeMaxTextSize="112sp"
            app:autoSizeMinTextSize="20sp"
            app:autoSizeStepGranularity="2sp"
            app:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/out_arrotondato"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnPrimaryContainer" />

        <LinearLayout
            android:id="@+id/result_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/Riquadro"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/out_pasto"
                    style="@style/RiquadroValore"
                    android:text="@string/placeholder" />

                <TextView
                    style="@style/RiquadroEtichetta"
                    android:text="@string/ui_pasto" />
            </LinearLayout>

            <LinearLayout
                style="@style/Riquadro"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/out_extra"
                    style="@style/RiquadroValore"
                    android:text="@string/placeholder" />

                <TextView
                    style="@style/RiquadroEtichetta"
                    android:text="@string/ui_extra" />
            </LinearLayout>

            <!-- Modalita' sviluppatore: insulina ancora attiva, sottratta dal totale -->
            <LinearLayout
                android:id="@+id/riquadro_iob"
                style="@style/Riquadro"
                android:layout_marginStart="12dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/out_iob"
                    style="@style/RiquadroValore" />

                <TextView
                    style="@style/RiquadroEtichetta"
                    android:text="@string/insulina_attiva" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
