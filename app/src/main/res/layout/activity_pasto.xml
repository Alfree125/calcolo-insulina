<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/menu_pasto"
        app:navigationContentDescription="@string/indietro"
        app:navigationIcon="@drawable/ic_indietro"
        app:title="@string/pasto_titolo" />

    <!-- Totale e alimenti scelti -->
    <com.google.android.material.card.MaterialCardView
        style="?attr/materialCardViewFilledStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margine_laterale"
        android:layout_marginEnd="@dimen/margine_laterale"
        app:cardBackgroundColor="?attr/colorPrimaryContainer"
        app:cardCornerRadius="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cho_del_pasto"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/out_totale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceDisplaySmall"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <TextView
                android:id="@+id/testo_vuoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/pasto_vuoto"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnPrimaryContainer" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scroll_chip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_pasto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campo_cerca"
        style="@style/Campo"
        android:layout_marginStart="@dimen/margine_laterale"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="@dimen/margine_laterale"
        android:hint="@string/cerca_alimento"
        app:endIconMode="clear_text"
        app:startIconDrawable="@drawable/ic_cerca">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/in_cerca"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <!-- Nessun risultato: proposta di aggiungere un alimento personale -->
        <LinearLayout
            android:id="@+id/gruppo_nessun_risultato"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/testo_nessun_risultato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <Button
                android:id="@+id/btn_nuovo_da_ricerca"
                style="@style/Widget.Material3.Button.TonalButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/nuovo_alimento"
                app:icon="@drawable/ic_aggiungi" />

            <Button
                android:id="@+id/btn_cerca_online"
                style="@style/Widget.Material3.Button.TextButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/cerca_online"
                android:visibility="gone"
                app:icon="@drawable/ic_globo" />
        </LinearLayout>
    </FrameLayout>

    <Button
        android:id="@+id/btn_usa"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margine_laterale"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="@dimen/margine_laterale"
        android:layout_marginBottom="12dp"
        android:enabled="false"
        android:minHeight="56dp" />
</LinearLayout>
